{
  "name": "rahuly-website",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.17.0 <12"
  },
  "scripts": {
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "react-router build",
    "verify:static": "node scripts/verify-static-build.mjs",
    "preview": "sirv build/client --single __spa-fallback.html --host 127.0.0.1 --port 4173",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run verify:static"
  },
  "dependencies": {
    "@rahulyadev/design-system": "1.0.0",
    "@react-router/node": "8.3.0",
    "isbot": "5.2.1",
    "markdown-it": "15.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "sirv-cli": "3.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  }
}
